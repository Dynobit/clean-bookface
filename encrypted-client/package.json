  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
