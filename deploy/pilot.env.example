# Copy outside the repository. Fill every blank before validation or launch.
# Build the reviewed application commit on the Pi or publish its ARM64 image.
APP_IMAGE=
# Exact local image ID: sha256:<64 lowercase hex digits>, or registry/name@sha256:<digest>.
# Required: cloudflare/cloudflared:<reviewed-version>@sha256:<verified-digest>
TUNNEL_IMAGE=cloudflare/cloudflared:2026.9.3@sha256:072c067d25ccbe61d46e18f0d0723255f2bb5304f7317caa95b27031520ff92c
# Host file: root:65532 mode 0440, or uid 65532 mode 0400; no world access.
TUNNEL_TOKEN_FILE=/secure/clean-bookface/tunnel-token
APP_ORIGIN=https://pilot.project.example.org
INSTANCE_NAME=Clean Bookface pilot
MAX_ACCOUNTS=25
ARCHIVE_ACCOUNT_BYTES=1073741824
# Choose these once from the approved launch date; do not regenerate on restart.
# Full UTC ISO timestamps: YYYY-MM-DDTHH:MM:SSZ
# Export-only begins 14 days before the end of the 90-day pilot.
PILOT_STARTS_AT=
PILOT_READ_ONLY_AT=
PILOT_ENDS_AT=
MAINTENANCE_MODE=false

# Use deploy/pilot-control.mjs plan/preflight before installation.
# Compose restart is disabled: the generated systemd startup service checks the
# fixed end date before starting. Its persistent deadline timer stops both
# services without removing the data volume. Never use raw compose up on reboot.
