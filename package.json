{
  "name": "clean-bookface",
  "version": "0.1.0",
  "private": true,
  "description": "Your memories, your friends, your rules.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.4.0 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "setup": "tsx src/cli.ts setup",
    "backup": "tsx src/cli.ts backup",
    "restore": "tsx src/cli.ts restore",
    "demo": "tsx scripts/demo.ts",
    "check:repository": "node scripts/check-repository.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" \"public/*.{css,js}\" \"*.{json,yaml,ts,mjs}\" \".github/**/*.yml\" \".railway/*.ts\" \"encrypted-client/src/**/*.{ts,css}\" \"encrypted-client/tests/**/*.ts\" \"encrypted-client/*.{ts,html,json}\" \"encrypted-host/*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" \"public/*.{css,js}\" \"*.{json,yaml,ts,mjs}\" \".github/**/*.yml\" \".railway/*.ts\" \"encrypted-client/src/**/*.{ts,css}\" \"encrypted-client/tests/**/*.ts\" \"encrypted-client/*.{ts,html,json}\" \"encrypted-host/*.json\"",
    "test:container": "node scripts/container-smoke.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "test:provider": "node scripts/provider-smoke.mjs"
  },
  "dependencies": {
    "@fedify/fedify": "2.4.0",
    "@hono/node-server": "2.1.3",
    "@node-rs/argon2": "2.2.1",
    "busboy": "1.6.0",
    "hono": "4.13.12",
    "ipaddr.js": "2.5.0",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/busboy": "1.5.4",
    "@types/node": "24.19.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "prettier": "3.9.9",
    "temporal-polyfill": "1.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0"
  }
}
